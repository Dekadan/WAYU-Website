---
import type { GetStaticPaths } from 'astro';
import PostDetail from '../../../views/PostDetail.astro';
import { getSection, entrySlug } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const entries = await getSection('news', 'tr');
  return entries.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<PostDetail lang="tr" section="news" entry={entry} />
