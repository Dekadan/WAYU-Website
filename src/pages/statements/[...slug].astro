---
import type { GetStaticPaths } from 'astro';
import PostDetail from '../../views/PostDetail.astro';
import { getSection, entrySlug } from '../../lib/content';

export const getStaticPaths = (async () => {
  const entries = await getSection('statements', 'en');
  return entries.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<PostDetail lang="en" section="statements" entry={entry} />
