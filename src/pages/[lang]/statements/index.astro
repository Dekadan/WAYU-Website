---
import type { GetStaticPaths } from 'astro';
import SectionIndex from '../../../views/SectionIndex.astro';
import { prefixedLangs, useTranslations, type Lang } from '../../../i18n/utils';

export const getStaticPaths = (() => prefixedLangs.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<SectionIndex lang={lang} section="statements" title={t('nav.statements')} description={t('section.statements.description')} />
