---
import type { GetStaticPaths } from 'astro';
import AuthorsIndex from '../../../views/AuthorsIndex.astro';
import { prefixedLangs, useTranslations, type Lang } from '../../../i18n/utils';

export const getStaticPaths = (() => prefixedLangs.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<AuthorsIndex lang={lang} title={t('nav.authors')} description={t('section.authors.description')} />
