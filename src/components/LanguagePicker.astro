---
import { languages, localisePath, stripLang, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Languages the current page exists in. Others link to the nearest page that does exist. */
  available?: Lang[];
}

const { lang, available } = Astro.props;
const basePath = stripLang(Astro.url.pathname);
/** e.g. `/news/some-report` -> `/news`, so a missing translation lands on its section. */
const parentPath = basePath.split('/').slice(0, -1).join('/') || '/';

const options = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  name: languages[code],
  href: localisePath(!available || available.includes(code) ? basePath : parentPath, code),
}));
---

<details class="group/lang relative" data-lang-menu>
  <summary
    class="flex h-10 cursor-pointer list-none items-center gap-1.5 rounded-full border border-[var(--border)] px-3 font-display text-sm font-semibold uppercase transition hover:bg-[var(--surface-sunken)] [&::-webkit-details-marker]:hidden"
    aria-label={languages[lang]}
  >
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"></path>
    </svg>
    {lang}
  </summary>
  <ul
    class="absolute end-0 top-12 z-70 w-48 overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface-raised)] py-1.5 text-[var(--text)] shadow-[0_12px_32px_rgba(35,31,32,0.18)]"
  >
    {
      options.map((o) => (
        <li>
          <a
            href={o.href}
            hreflang={o.code}
            lang={o.code}
            aria-current={o.code === lang ? 'true' : undefined}
            class:list={[
              'flex items-center justify-between gap-3 px-4 py-2 font-display text-[0.95rem] transition hover:bg-[var(--surface-sunken)]',
              o.code === lang && 'font-semibold text-[var(--accent-ink)]',
            ]}
          >
            <span>{o.name}</span>
            <span class="text-xs uppercase text-[var(--text-faint)]">{o.code}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // Close the menu on outside click or Escape.
  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu][open]').forEach((menu) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu][open]').forEach((menu) => (menu.open = false));
  });
</script>
