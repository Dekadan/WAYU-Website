---
import { languages, localisePath, stripLang, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const basePath = stripLang(Astro.url.pathname);
---

<div class="flex items-center gap-0.5 text-[0.7rem]">
  {
    (Object.keys(languages) as Lang[]).map((code) => (
      <a
        href={localisePath(basePath, code)}
        hreflang={code}
        lang={code}
        aria-current={code === lang ? 'true' : undefined}
        class:list={[
          'eyebrow rounded-full px-2.5 py-1.5 transition',
          code === lang
            ? 'bg-[var(--accent)] text-[var(--accent-contrast)]'
            : 'opacity-60 hover:opacity-100',
        ]}
      >
        {code}
      </a>
    ))
  }
</div>
