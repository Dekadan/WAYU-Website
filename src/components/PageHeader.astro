---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-[var(--border)] bg-[var(--surface-sunken)]">
  <div class="container-page py-14 sm:py-20">
    {eyebrow && <p class="eyebrow text-[var(--accent)]">{eyebrow}</p>}
    <h1 class="headline mt-3 max-w-4xl text-4xl sm:text-5xl lg:text-6xl">{title}</h1>
    {
      description && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]">{description}</p>
      )
    }
  </div>
</section>
