---
import DiagonalEdge from './DiagonalEdge.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** Optional photo shown behind the title, darkened for legibility. */
  image?: string;
}

const { eyebrow, title, description, image } = Astro.props;
---

<section class="relative overflow-hidden bg-[var(--masthead)] text-[var(--masthead-text)]">
  {
    image && (
      <>
        <img src={image} alt="" class="absolute inset-0 size-full object-cover opacity-40" loading="eager" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-r rtl:bg-gradient-to-l from-[#231f20] via-[#231f20]/85 to-[#231f20]/30"></div>
      </>
    )
  }
  <div class="container-page relative pt-16 pb-24 sm:pt-20 sm:pb-32">
    {eyebrow && <p class="eyebrow text-[var(--accent)]">{eyebrow}</p>}
    <h1 class="headline mt-3 max-w-4xl text-[2.6rem] sm:text-6xl lg:text-7xl">{title}</h1>
    {
      description && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed opacity-85 sm:text-xl">{description}</p>
      )
    }
  </div>
  <DiagonalEdge />
</section>
