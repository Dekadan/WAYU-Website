---
interface Props {
  message: string;
}

const { message } = Astro.props;
---

<div class="border border-dashed border-[var(--border-strong)] px-6 py-16 text-center">
  <svg
    class="mx-auto size-10 opacity-20"
    viewBox="0 0 48 48"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <circle cx="24" cy="24" r="19"></circle>
    <ellipse cx="24" cy="24" rx="8" ry="19"></ellipse>
    <path d="M5.6 18h36.8M5.6 30h36.8"></path>
  </svg>
  <p class="mt-4 text-[var(--text-muted)]">{message}</p>
</div>
