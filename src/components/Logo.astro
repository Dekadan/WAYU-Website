---
/**
 * WAYU's emblem: the fist of oppressed nations resisting imperialist aircraft.
 *
 * The artwork is a fixed raster with black lettering, so it is never recoloured
 * for dark backgrounds. It always sits on white: either the hanging pennant
 * from the introduction booklet, or a plain white tile.
 */
interface Props {
  variant?: 'pennant' | 'tile';
  class?: string;
  alt?: string;
}

const { variant = 'tile', class: className = '', alt = '' } = Astro.props;
---

{
  variant === 'pennant' ? (
    <span class:list={['relative block', className]}>
      <svg
        class="absolute inset-0 size-full drop-shadow-[0_6px_10px_rgba(35,31,32,0.28)]"
        viewBox="0 0 100 128"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M0 0H100V128L50 110L0 128Z" fill="#fff" />
      </svg>
      <img
        src="/brand/wayu-logo.png"
        alt={alt}
        width="513"
        height="514"
        class="absolute start-[8%] top-[7%] w-[84%]"
        decoding="async"
      />
    </span>
  ) : (
    <span class:list={['grid place-items-center rounded-xl bg-white', className]}>
      <img src="/brand/wayu-logo.png" alt={alt} width="513" height="514" class="block size-[86%]" decoding="async" />
    </span>
  )
}
