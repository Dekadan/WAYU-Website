---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { localisePath, useTranslations, type Lang } from '../i18n/utils';
import { social, contactEmail, dossier } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

/** Empty sections stay out of the menus until something is published in them. */
const hasDocuments = (await getCollection('documents', (e) => !e.data.draft)).length > 0;
const hasArticles = (await getCollection('articles', (e) => !e.data.draft)).length > 0;
const hasAuthors = (await getCollection('authors', (e) => !e.data.draft)).length > 0;

const sections = [
  { path: '/statements', label: t('nav.statements') },
  ...(hasArticles ? [{ path: '/articles', label: t('nav.articles') }] : []),
  { path: '/news', label: t('nav.news') },
  ...(hasDocuments ? [{ path: '/documents', label: t('nav.documents') }] : []),
];

const about = [
  { path: '/about', label: t('nav.about') },
  { path: '/history', label: t('nav.history') },
  ...(hasAuthors ? [{ path: '/authors', label: t('nav.authors') }] : []),
  { path: '/join', label: t('nav.join') },
];
---

<footer class="mt-28 bg-[var(--masthead)] text-[var(--masthead-text)]">
  <div class="h-2 w-full bg-[var(--accent)]"></div>

  <div class="container-page pt-16 pb-12">
    <p class="font-display text-sm font-semibold text-[var(--accent)]" lang="es">El pueblo unido jamás será vencido</p>
    <p class="headline mt-3 max-w-3xl text-3xl sm:text-5xl">{t('footer.slogan')}</p>
  </div>

  <div class="container-page grid gap-12 pb-14 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <div class="flex items-center gap-4">
        <Logo class="size-20 shrink-0" />
        <div>
          <p class="font-display text-xl font-bold">WAYU</p>
          <p class="text-sm opacity-75">{t('site.fullName')}</p>
        </div>
      </div>
      <p class="mt-6 max-w-sm text-sm leading-relaxed opacity-75">
        Peace at Home, Peace in the World · <span lang="tr">Yurtta Barış, Dünyada Barış</span>
      </p>
      {
        contactEmail && (
          <a
            href={`mailto:${contactEmail}`}
            class="link-underline mt-4 inline-block text-sm opacity-85 hover:opacity-100"
          >
            {contactEmail}
          </a>
        )
      }
    </div>

    <div>
      <h2 class="eyebrow text-[var(--accent)]">{t('footer.sections')}</h2>
      <ul class="mt-4 space-y-2.5 text-[0.95rem]">
        {
          sections.map((link) => (
            <li>
              <a href={localisePath(link.path, lang)} class="opacity-80 transition hover:opacity-100">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="eyebrow text-[var(--accent)]">{t('footer.about')}</h2>
      <ul class="mt-4 space-y-2.5 text-[0.95rem]">
        {
          about.map((link) => (
            <li>
              <a href={localisePath(link.path, lang)} class="opacity-80 transition hover:opacity-100">
                {link.label}
              </a>
            </li>
          ))
        }
        {
          dossier && (
            <li>
              <a href={dossier.pdf} class="opacity-80 transition hover:opacity-100">{t('home.dossier')}</a>
            </li>
          )
        }
        <li>
          <a href={localisePath('/rss.xml', lang)} class="opacity-80 transition hover:opacity-100">{t('footer.rss')}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="bg-black/25">
    <div
      class="container-page flex flex-col-reverse items-center justify-between gap-5 py-6 text-xs opacity-75 sm:flex-row"
    >
      <p>© {year} {t('site.fullName')}. {t('footer.rights')}</p>

      <ul class="flex items-center gap-4">
        {
          social.map((item) => (
            <li>
              <a
                href={item.url}
                rel="me noopener noreferrer"
                target="_blank"
                aria-label={item.name}
                class="block transition hover:text-[var(--accent)]"
              >
                <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={item.icon} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
