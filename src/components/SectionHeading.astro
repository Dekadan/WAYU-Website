---
interface Props {
  title: string;
  href?: string;
  viewAllLabel?: string;
  as?: 'h2' | 'h3';
}

const { title, href, viewAllLabel, as: Tag = 'h2' }: Props = Astro.props;
---

<div class="mb-7 flex items-end justify-between gap-6 border-b-2 border-[var(--text)] pb-3">
  <Tag class="headline text-2xl sm:text-[1.75rem]">{title}</Tag>
  {
    href && viewAllLabel && (
      <a
        href={href}
        class="eyebrow link-underline shrink-0 pb-1 text-[var(--accent)] whitespace-nowrap"
      >
        {viewAllLabel} →
      </a>
    )
  }
</div>
