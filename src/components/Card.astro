---
import { dirOf, formatDate, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  href: string;
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  date?: Date;
  kicker?: string;
  author?: string;
  lang: Lang;
  /** Language the entry itself is written in, when it differs from the page. */
  contentLang?: Lang;
  /**
   * `lead` is the oversized homepage headline, `feature` a large grid item,
   * `compact` a text-only row for dense lists.
   */
  variant?: 'lead' | 'feature' | 'compact';
  class?: string;
}

const {
  href,
  title,
  description,
  image,
  imageAlt,
  date,
  kicker,
  author,
  lang,
  contentLang,
  variant = 'feature',
  class: className = '',
} = Astro.props;

const t = useTranslations(lang);

const titleSize = {
  lead: 'text-3xl sm:text-4xl lg:text-[2.75rem]',
  feature: 'text-xl sm:text-[1.35rem]',
  compact: 'text-base',
}[variant];

const aspect = variant === 'lead' ? 'aspect-[16/9]' : 'aspect-[3/2]';
---

<article class:list={['group flex flex-col', className]} lang={contentLang && contentLang !== lang ? contentLang : undefined} dir={contentLang ? dirOf(contentLang) : undefined}>
  {
    variant !== 'compact' && (
      <a href={href} tabindex="-1" aria-hidden="true" class="block overflow-hidden rounded-2xl bg-[var(--surface-sunken)]">
        <div class:list={[aspect, 'relative w-full']}>
          {image ? (
            <img
              src={image}
              alt={imageAlt ?? ''}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-[1.03]"
            />
          ) : (
            /*
             * Posts often go up without a picture. Rather than a blank grey
             * box, fall back to the emblem on the masthead colour so the slot
             * reads as designed and grids stay aligned.
             */
            <div class="absolute inset-0 overflow-hidden bg-[#231f20]">
              <div class="absolute -inset-x-6 top-[46%] h-[9%] -rotate-6 bg-[var(--accent)]" />
              <span class="absolute start-4 top-4 grid size-12 place-items-center rounded-lg bg-white">
                <img src="/brand/wayu-logo.png" alt="" class="size-[86%]" loading="lazy" />
              </span>
              {date && (
                <span class="absolute end-5 bottom-3 font-display text-[3.4rem] leading-none font-bold text-white/90">
                  {date.getUTCFullYear()}
                </span>
              )}
            </div>
          )}
        </div>
      </a>
    )
  }

  <div class:list={['flex flex-1 flex-col', variant !== 'compact' && 'pt-4']}>
    {
      (kicker || date) && (
        <div class="eyebrow flex flex-wrap items-center gap-x-2 gap-y-1">
          {kicker && <span class="rounded-full bg-[var(--accent)] px-2.5 py-1 text-[var(--accent-contrast)]">{kicker}</span>}
          {date && (
            <time datetime={date.toISOString()} class="font-medium text-[var(--text-faint)]">
              {formatDate(date, lang)}
            </time>
          )}
        </div>
      )
    }

    <h3 class:list={['headline mt-3', titleSize]}>
      <a href={href} class="transition group-hover:text-[var(--accent-ink)]">
        <span class:list={[variant === 'lead' ? '' : 'clamp-3']}>{title}</span>
      </a>
    </h3>

    {
      description && variant !== 'compact' && (
        <p class="clamp-3 mt-3 text-[0.95rem] leading-relaxed text-[var(--text-muted)]">{description}</p>
      )
    }

    {
      author && (
        <p class="eyebrow mt-3.5 text-[var(--text-faint)]">
          {t('post.by')} <span class="text-[var(--text-muted)]">{author}</span>
        </p>
      )
    }
  </div>
</article>
