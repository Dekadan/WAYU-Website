---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import { contactEmail, social } from '../lib/site';

interface Props {
  lang: Lang;
  /** Slug under `src/content/pages/<lang>/`, e.g. `about`. */
  slug: string;
  /** Fallback title used when the markdown file has not been created yet. */
  fallbackTitle: string;
  /** Appends the contact block — used by the Join page. */
  showContact?: boolean;
}

const { lang, slug, fallbackTitle, showContact = false } = Astro.props;
const t = useTranslations(lang);

const page = await getEntry('pages', `${lang}/${slug}`);
const rendered = page ? await render(page) : undefined;
const Content = rendered?.Content;
---

<BaseLayout lang={lang} title={page?.data.title ?? fallbackTitle} description={page?.data.description}>
  <PageHeader
    eyebrow={t('site.name')}
    title={page?.data.title ?? fallbackTitle}
    description={page?.data.description}
  />

  {
    page?.data.image && (
      <figure class="container-page mt-12">
        <img
          src={page.data.image}
          alt={page.data.imageAlt ?? ''}
          class="w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </figure>
    )
  }

  {
    page && page.data.stats.length > 0 && (
      <section class="container-page mt-14">
        <dl class="grid grid-cols-2 gap-8 border-y-2 border-[var(--text)] py-10 sm:grid-cols-4">
          {page.data.stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="headline block text-4xl text-[var(--accent)] sm:text-5xl">
                  {stat.value}
                </span>
                <span class="mt-2.5 block text-xs leading-snug text-[var(--text-muted)]">
                  {stat.label}
                </span>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <div class="container-page py-14">
    <div class="mx-auto max-w-[46rem]">
      {
        Content ? (
          <div class="prose-wayu">
            <Content />
          </div>
        ) : (
          <p class="text-[var(--text-muted)]">{t('list.empty')}</p>
        )
      }
    </div>
  </div>

  {
    page && page.data.highlights.length > 0 && (
      <section class="container-page pb-14">
        <ul class="grid gap-px border border-[var(--border)] bg-[var(--border)] sm:grid-cols-2 lg:grid-cols-3">
          {page.data.highlights.map((item) => (
            <li class="bg-[var(--surface-raised)] p-8">
              <h2 class="headline text-xl">{item.title}</h2>
              <p class="mt-3 leading-relaxed text-[var(--text-muted)]">{item.body}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    showContact && (
      <section class="container-page pb-20">
        <div class="border-y-2 border-[var(--accent)] bg-[var(--masthead)] px-8 py-14 text-[var(--masthead-text)] sm:px-12">
          <h2 class="headline text-3xl">{t('home.join.cta')}</h2>
          <a
            href={`mailto:${contactEmail}`}
            class="headline mt-4 inline-block text-2xl text-[var(--accent)] underline underline-offset-4 sm:text-3xl"
          >
            {contactEmail}
          </a>

          <ul class="mt-10 flex flex-wrap gap-3">
            {social.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="eyebrow inline-flex items-center gap-2.5 rounded-full border border-white/25 px-4 py-3 transition hover:border-[var(--accent)] hover:text-[var(--accent)]"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={item.icon} />
                  </svg>
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
