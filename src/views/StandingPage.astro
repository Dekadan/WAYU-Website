---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Committee from '../components/Committee.astro';
import { dirOf, useTranslations, type Lang } from '../i18n/utils';
import { contactEmail, social } from '../lib/site';

interface Props {
  lang: Lang;
  /** Slug under `src/content/pages/<lang>/`, e.g. `about`. */
  slug: string;
  /** Fallback title used when the markdown file has not been created yet. */
  fallbackTitle: string;
  /** Appends the contact block — used by the Join page. */
  showContact?: boolean;
}

const { lang, slug, fallbackTitle, showContact = false } = Astro.props;
const t = useTranslations(lang);

const page = (await getEntry('pages', `${lang}/${slug}`)) ?? (await getEntry('pages', `en/${slug}`));
const pageLang = page ? (page.id.split('/')[0] as Lang) : lang;
const rendered = page ? await render(page) : undefined;
const Content = rendered?.Content;
---

<BaseLayout lang={lang} title={page?.data.title ?? fallbackTitle} description={page?.data.description}>
  <PageHeader
    eyebrow={t('site.fullName')}
    title={page?.data.title ?? fallbackTitle}
    description={page?.data.description}
    image={page?.data.image}
  />

  {
    page && page.data.stats.length > 0 && (
      <section class="container-page mt-14">
        <dl class="grid grid-cols-2 gap-x-8 gap-y-10 rounded-2xl bg-[var(--surface-sunken)] p-8 sm:grid-cols-4 sm:p-10">
          {page.data.stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="headline block text-5xl text-[var(--accent-ink)] sm:text-6xl">
                  {stat.value}
                </span>
                <span class="mt-2.5 block text-sm leading-snug text-[var(--text-muted)]">
                  {stat.label}
                </span>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <div class="container-page py-14">
    <div class="mx-auto max-w-[46rem]">
      {
        Content ? (
          <div class="prose-wayu" lang={pageLang !== lang ? pageLang : undefined} dir={dirOf(pageLang)}>
            {pageLang !== lang && <p class="text-sm text-[var(--text-faint)]" lang={lang}>{t('lang.fallback')}</p>}
            <Content />
          </div>
        ) : (
          <p class="text-[var(--text-muted)]">{t('list.empty')}</p>
        )
      }
    </div>
  </div>

  {
    page && page.data.highlights.length > 0 && (
      <section class="container-page pb-6">
        <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {page.data.highlights.map((item, i) => (
            <li class="flex gap-4 rounded-2xl bg-[var(--surface-sunken)] p-6">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-[var(--accent)] font-display font-bold text-[var(--accent-contrast)]">
                {i + 1}
              </span>
              <div>
                <h2 class="headline text-xl">{item.title}</h2>
                <p class="mt-2 leading-relaxed text-[var(--text-muted)]">{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {slug === 'about' && <Committee lang={lang} />}

  {
    showContact && (contactEmail || social.length > 0) && (
      <section class="container-page pb-20">
        <div class="rounded-2xl bg-[var(--masthead)] px-8 py-14 text-[var(--masthead-text)] sm:px-12">
          <h2 class="headline text-3xl">{t('home.join.cta')}</h2>
          {contactEmail && (<a
            href={`mailto:${contactEmail}`}
            class="headline mt-4 inline-block text-2xl text-[var(--accent)] underline underline-offset-4 sm:text-3xl"
          >
            {contactEmail}
          </a>)}

          <ul class="mt-10 flex flex-wrap gap-3">
            {social.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="eyebrow inline-flex items-center gap-2.5 rounded-full border border-white/25 px-4 py-3 transition hover:border-[var(--accent)] hover:text-[var(--accent)]"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={item.icon} />
                  </svg>
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
