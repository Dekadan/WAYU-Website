---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EmptyState from '../components/EmptyState.astro';
import { useTranslations, type Lang } from '../i18n/utils';
import { authorUrl, entrySlug, getAuthors, getSection } from '../lib/content';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);

const [authors, articles] = await Promise.all([getAuthors(lang), getSection('articles', lang)]);

const counts = new Map<string, number>();
for (const article of articles) {
  const slug = (article.data as { author?: string }).author;
  if (slug) counts.set(slug, (counts.get(slug) ?? 0) + 1);
}
---

<BaseLayout lang={lang} title={title} description={description}>
  <PageHeader eyebrow={t('site.name')} title={title} description={description} />

  <div class="container-page py-14">
    {
      authors.length > 0 ? (
        <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {authors.map((author) => {
            const { name, role, organization, country, bio, avatar } = author.data;
            const detail = [role, organization, country].filter(Boolean).join(' · ');
            const count = counts.get(entrySlug(author)) ?? 0;

            return (
              <li>
                <a
                  href={authorUrl(author.id)}
                  class="group flex h-full flex-col border border-[var(--border)] bg-[var(--surface-raised)] p-6 transition hover:border-[var(--accent)]"
                >
                  {avatar ? (
                    <img
                      src={avatar}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="size-16 rounded-full object-cover"
                    />
                  ) : (
                    <span class="grid size-16 place-items-center rounded-full bg-[var(--accent)] font-display text-xl font-bold text-[var(--accent-contrast)]">
                      {name.trim().charAt(0).toUpperCase()}
                    </span>
                  )}

                  <h2 class="headline mt-5 text-xl transition group-hover:text-[var(--accent)]">
                    {name}
                  </h2>
                  {detail && <p class="mt-1.5 text-sm text-[var(--text-faint)]">{detail}</p>}
                  {bio && (
                    <p class="clamp-3 mt-4 text-[0.95rem] leading-relaxed text-[var(--text-muted)]">
                      {bio}
                    </p>
                  )}

                  <span class="eyebrow mt-auto pt-6 text-[var(--text-faint)]">
                    {count} {t('home.articles')}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <EmptyState message={t('list.empty')} />
      )
    }
  </div>
</BaseLayout>
