---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AuthorChip from '../components/AuthorChip.astro';
import EmptyState from '../components/EmptyState.astro';
import DiagonalEdge from '../components/DiagonalEdge.astro';
import { formatDate, localisePath, useTranslations, type Lang } from '../i18n/utils';
import {
  entryUrl,
  findAuthor,
  getAuthors,
  getDocuments,
  getFeed,
  getSection,
  authorUrl,
  entryLang,
} from '../lib/content';
import { getHistory, historyImage, historySlug, historyWhen } from '../lib/history';
import { dossier } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const [feed, statements, articles, news, documents, authors, about, history] = await Promise.all([
  getFeed(lang),
  getSection('statements', lang),
  getSection('articles', lang),
  getSection('news', lang),
  getDocuments(lang),
  getAuthors(lang),
  (async () => (await getEntry('pages', `${lang}/about`)) ?? (await getEntry('pages', 'en/about')))(),
  getHistory(lang),
]);

const timeline = [...history].reverse();

/*
 * The lead story is whichever item is marked `featured`, falling back to the
 * newest thing published so the homepage is never empty.
 */
const featured = feed.filter((item) => item.entry.data.featured);
const ordered = [...featured, ...feed.filter((item) => !item.entry.data.featured)];
const [lead, ...rest] = ordered;
const secondary = rest.slice(0, 4);

const sectionLabels: Record<string, string> = {
  statements: t('home.statements'),
  articles: t('home.articles'),
  news: t('home.news'),
};

/** Bylines are resolved up front so the template stays declarative. */
const articleCards = await Promise.all(
  articles.slice(0, 6).map(async (entry) => ({
    entry,
    author: await findAuthor((entry.data as { author?: string }).author, lang),
  })),
);

const leadAuthor =
  lead && lead.section === 'articles'
    ? await findAuthor((lead.entry.data as { author?: string }).author, lang)
    : undefined;
---

<BaseLayout lang={lang} description={about?.data.description}>
  {/* ---------------------------------------------------------------- Hero */}
  <section class="relative isolate overflow-hidden bg-[#231f20] text-white">
    <img
      src="/uploads/hero-2018-delegates.jpg"
      alt={t('home.hero.imageAlt')}
      class="absolute inset-x-0 top-0 -z-10 h-[52%] w-full object-cover object-[74%_62%] md:inset-0 md:h-full md:object-[50%_40%]"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-x-0 top-0 -z-10 h-[52%] bg-gradient-to-t from-[#231f20] via-[#231f20]/20 to-transparent md:hidden"></div>
    <div class="absolute inset-0 -z-10 hidden bg-gradient-to-r from-[#231f20]/95 rtl:bg-gradient-to-l via-[#231f20]/70 to-[#231f20]/10 md:block"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 hidden h-1/2 bg-gradient-to-t from-[#231f20]/70 to-transparent md:block"></div>

    <div class="container-page flex min-h-[min(86vh,50rem)] flex-col justify-end pt-[19rem] pb-[clamp(5rem,11vw,9rem)] md:pt-44">
      <p class="w-fit rounded-full bg-[var(--accent)] px-3.5 py-1.5 font-display text-sm font-semibold text-[#231f20]">
        {t('home.hero.kicker')}
      </p>
      <h1 class="headline mt-5 max-w-4xl text-[2.7rem] leading-[1.02] sm:text-6xl lg:text-[5.2rem]">
        {t('home.hero.title')}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85 sm:text-xl">{t('home.hero.body')}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={localisePath('/about', lang)}
          class="rounded-full bg-[var(--accent)] px-6 py-3.5 font-display font-semibold text-[#231f20] transition hover:brightness-105"
        >
          {t('home.hero.cta')} <span class="inline-block rtl:-scale-x-100" aria-hidden="true">→</span>
        </a>
        {
          dossier ? (
            <a
              href={dossier.pdf}
              class="rounded-full border-2 border-white/70 px-6 py-3 font-display font-semibold transition hover:border-white hover:bg-white hover:text-[#231f20]"
            >
              {t('home.dossier')}
            </a>
          ) : (
            <a
              href={localisePath('/history', lang)}
              class="rounded-full border-2 border-white/70 px-6 py-3 font-display font-semibold transition hover:border-white hover:bg-white hover:text-[#231f20]"
            >
              {t('nav.history')}
            </a>
          )
        }
      </div>
    </div>
    <DiagonalEdge />
  </section>

  {/* ---------------------------------------------------------------- Latest */}
  <section class="container-page pt-10 pb-6 sm:pt-14">
    <SectionHeading title={t('home.latest')} />
    {
      lead ? (
        <div class="grid gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
          <div>
            <Card
              lang={lang}
              contentLang={entryLang(lead.entry)}
              variant="lead"
              href={entryUrl(lead.section, lead.entry)}
              title={lead.entry.data.title}
              description={lead.entry.data.description}
              image={lead.entry.data.image}
              imageAlt={lead.entry.data.imageAlt}
              date={lead.entry.data.date}
              kicker={sectionLabels[lead.section]}
            />
            {leadAuthor && (
              <div class="mt-6">
                <AuthorChip author={leadAuthor} />
              </div>
            )}
          </div>

          <div class="flex flex-col gap-3">
            {secondary.map((item) => (
              <div class="rounded-2xl bg-[var(--surface-sunken)] p-5 transition hover:bg-[var(--border)]">
                <Card
                  lang={lang}
                  contentLang={entryLang(item.entry)}
                  variant="compact"
                  href={entryUrl(item.section, item.entry)}
                  title={item.entry.data.title}
                  date={item.entry.data.date}
                  kicker={sectionLabels[item.section]}
                />
              </div>
            ))}
          </div>
        </div>
      ) : (
        <EmptyState message={t('list.empty')} />
      )
    }
  </section>

  {/* ------------------------------------------------------- Where we stand */}
  {
    about && about.data.highlights.length > 0 && (
      <section class="relative mt-20 overflow-hidden bg-[var(--masthead)] text-[var(--masthead-text)]">
        <div class="h-2 w-full bg-[var(--accent)]" />
        <div class="container-page py-16 sm:py-24">
          <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,2fr)] lg:gap-16">
            <div>
              <h2 class="headline text-4xl sm:text-5xl">{t('home.stand.title')}</h2>
              <p class="mt-4 text-xl leading-snug text-[var(--accent)]">{t('home.stand.lead')}</p>
              <a
                href={localisePath('/about', lang)}
                class="mt-8 inline-block rounded-full bg-[var(--accent)] px-6 py-3.5 font-display font-semibold text-[#231f20] transition hover:brightness-105"
              >
                {t('home.about.cta')} <span class="inline-block rtl:-scale-x-100" aria-hidden="true">→</span>
              </a>
            </div>
            <ol class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
              {about.data.highlights.map((item, i) => (
                <li class="flex gap-4">
                  <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-[var(--accent)] font-display text-lg font-bold text-[#231f20]">
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="headline text-xl">{item.title}</h3>
                    <p class="mt-1.5 leading-relaxed text-white/75">{item.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    )
  }

  {/* --------------------------------------------------------------- History */}
  {
    timeline.length > 0 && (
      <section class="mt-20 sm:mt-24">
        <div class="container-page">
          <SectionHeading
            title={t('home.history.title')}
            lead={t('home.history.lead')}
            href={localisePath('/history', lang)}
            viewAllLabel={t('home.history.cta')}
          />
        </div>
        <ul class="container-page flex snap-x snap-mandatory scroll-px-5 gap-5 overflow-x-auto pb-6 [scrollbar-width:thin] md:scroll-px-8">
          {timeline.map((entry) => {
            const cover = historyImage(entry);
            return (
              <li class="w-[17rem] shrink-0 snap-start sm:w-[19rem]">
                <a href={`${localisePath('/history', lang)}#${historySlug(entry)}`} class="group block">
                  <div class="frame-orange relative">
                    {cover && (
                      <img
                        src={cover.src}
                        alt={cover.alt}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.04]"
                      />
                    )}
                    <span class="absolute start-0 bottom-0 rounded-se-xl bg-[var(--accent)] px-3 pt-1.5 pb-1 font-display text-2xl font-bold text-[#231f20]">
                      {entry.data.date.getUTCFullYear()}
                    </span>
                  </div>
                  <p class="mt-3 text-sm font-medium text-[var(--text-faint)]">
                    {[historyWhen(entry, lang), entry.data.place].filter(Boolean).join(' · ')}
                  </p>
                  <h3 class="headline mt-1 text-lg transition group-hover:text-[var(--accent-ink)]">
                    {entry.data.title}
                  </h3>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {/* ---------------------------------------------------------- Statements */}
  {
    statements.length > 0 && (
      <section class="container-page mt-20">
        <SectionHeading
          title={t('home.statements')}
          href={localisePath('/statements', lang)}
          viewAllLabel={t('list.viewAll')}
        />
        <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {statements.slice(0, 3).map((entry) => (
            <Card
              lang={lang}
              contentLang={entryLang(entry)}
              href={entryUrl('statements', entry)}
              title={entry.data.title}
              description={entry.data.description}
              image={entry.data.image}
              imageAlt={entry.data.imageAlt}
              date={entry.data.date}
              kicker={(entry.data as { issuedBy?: string }).issuedBy ?? t('home.statements')}
            />
          ))}
        </div>
      </section>
    )
  }

  {/* ------------------------------------------------------------ Articles */}
  {
    articleCards.length > 0 && (
      <section class="container-page mt-24">
        <SectionHeading
          title={t('home.articles')}
          href={localisePath('/articles', lang)}
          viewAllLabel={t('list.viewAll')}
        />
        <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {articleCards.map(({ entry, author }) => (
            <Card
              lang={lang}
              contentLang={entryLang(entry)}
              href={entryUrl('articles', entry)}
              title={entry.data.title}
              description={entry.data.description}
              image={entry.data.image}
              imageAlt={entry.data.imageAlt}
              date={entry.data.date}
              kicker={t('home.articles')}
              author={author?.data.name}
            />
          ))}
        </div>
      </section>
    )
  }

  {/* ---------------------------------------------------------------- News */}
  {
    news.length > 0 && (
      <section class="container-page mt-24">
        <SectionHeading
          title={t('home.news')}
          href={localisePath('/news', lang)}
          viewAllLabel={t('list.viewAll')}
        />
        <ul class="grid gap-3 sm:grid-cols-2">
          {news.slice(0, 6).map((entry) => (
            <li>
              <a
                href={entryUrl('news', entry)}
                class="group flex h-full gap-5 rounded-2xl bg-[var(--surface-sunken)] p-5 transition hover:bg-[var(--border)]"
              >
                <time
                  datetime={entry.data.date.toISOString()}
                  class="w-24 shrink-0 pt-0.5 font-display text-sm font-semibold text-[var(--accent-ink)]"
                >
                  {formatDate(entry.data.date, lang)}
                </time>
                <span class="headline clamp-2 text-lg">{entry.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* --------------------------------------------------------------- Dossier */}
  {
    dossier && (
  <section class="container-page mt-24">
    <div class="grid items-center gap-8 overflow-hidden rounded-3xl bg-[var(--surface-sunken)] p-8 sm:grid-cols-[auto_1fr] sm:gap-12 sm:p-12">
      <a href={dossier.pdf} class="mx-auto block w-44 sm:w-52">
        <img
          src={dossier.cover}
          alt=""
          loading="lazy"
          class="w-full -rotate-3 rounded-md shadow-[0_18px_40px_rgba(35,31,32,0.28)] transition hover:rotate-0"
        />
      </a>
      <div>
        <h2 class="headline text-3xl sm:text-4xl">{t('home.dossier.title')}</h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-[var(--text-muted)]">{t('home.dossier.body')}</p>
        <a
          href={dossier.pdf}
          class="mt-7 inline-block rounded-full bg-[var(--accent)] px-6 py-3.5 font-display font-semibold text-[var(--accent-contrast)] transition hover:brightness-105"
        >
          {t('home.dossier.cta')} ↓
        </a>
      </div>
    </div>
  </section>
    )
  }

  {/* ----------------------------------------------------------- Documents */}
  {
    documents.length > 0 && (
      <section class="container-page mt-24">
        <SectionHeading
          title={t('home.documents')}
          href={localisePath('/documents', lang)}
          viewAllLabel={t('list.viewAll')}
        />
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {documents.slice(0, 6).map((entry) => (
            <li>
              <a
                href={entryUrl('documents', entry)}
                class="group flex h-full flex-col justify-between gap-6 rounded-2xl border-2 border-[var(--accent)] p-6 transition hover:bg-[var(--accent)] hover:text-[var(--accent-contrast)]"
              >
                <span class="headline block text-xl">{entry.data.title}</span>
                <span class="font-display text-sm font-semibold">{t('list.readMore')} <span class="inline-block rtl:-scale-x-100" aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ------------------------------------------------------------- Authors */}
  {
    authors.length > 0 && (
      <section class="container-page mt-24">
        <SectionHeading
          title={t('home.authors')}
          href={localisePath('/authors', lang)}
          viewAllLabel={t('list.viewAll')}
        />
        <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
          {authors.slice(0, 6).map((author) => (
            <li>
              <a href={authorUrl(author.id)} class="block">
                <AuthorChip author={author} link={false} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ---------------------------------------------------------------- Join */}
  <section class="container-page mt-24">
    <div class="relative overflow-hidden rounded-3xl bg-[var(--accent)] px-8 py-14 text-[#231f20] sm:px-14 sm:py-20">
      <div class="relative max-w-2xl">
        <h2 class="headline text-3xl sm:text-4xl lg:text-5xl">{t('home.join.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed">{t('home.join.body')}</p>
        <a
          href={localisePath('/join', lang)}
          class="mt-9 inline-block rounded-full bg-[#231f20] px-6 py-4 font-display font-semibold text-white transition hover:opacity-90"
        >
          {t('home.join.cta')} <span class="inline-block rtl:-scale-x-100" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
