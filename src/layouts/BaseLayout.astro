---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { cleanPath, languages, localisePath, stripLang, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Absolute path under /public for the social preview image. */
  image?: string;
  /** `article` for individual posts, `website` for indexes. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const t = useTranslations(lang);
const siteName = t('site.fullName');
const pageTitle = title ? `${title} — ${t('site.name')}` : `${t('site.name')} — ${siteName}`;
const pageDescription = description ?? t('site.tagline');

const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const socialImage = new URL(image ?? '/og-default.png', Astro.site);
const basePath = stripLang(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />

    {
      (Object.keys(languages) as Lang[]).map((code) => (
        <link rel="alternate" hreflang={code} href={new URL(localisePath(basePath, code), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localisePath(basePath, 'en'), Astro.site)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} — RSS`}
      href={new URL(lang === 'en' ? '/rss.xml' : `/${lang}/rss.xml`, Astro.site)}
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_GB'} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteName} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="theme-color" content="#141413" />

    {/* Applied before first paint so the page never flashes the wrong theme. */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('wayu-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="eyebrow sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-100 focus:rounded-full focus:bg-[var(--accent)] focus:px-4 focus:py-3 focus:text-[var(--accent-contrast)]"
    >
      {t('nav.skip')}
    </a>

    <Header lang={lang} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
